{
   "name": "nestjs-starter",
   "version": "0.0.1",
   "description": "",
   "author": "",
   "private": true,
   "license": "UNLICENSED",
   "type": "module",
   "scripts": {
      "build": "npm run build:server && npm run build:client",
      "build:server": "prisma generate && nest build",
      "build:client": "vite build --config client/vite.config.ts",
      "start": "node dist/main",
      "start:prod": "cross-env NODE_ENV=production node dist/main",
      "start:dev": "concurrently -n api,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
      "dev:server": "nest start --watch",
      "dev:client": "vite --config client/vite.config.ts",
      "dev:debug": "nest start --debug --watch",
      "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "jest --config ./test/jest-e2e.json",
      "test:type-check": "tsc --noEmit",
      "prisma:generate": "prisma generate",
      "prisma:migrate": "prisma migrate dev",
      "prisma:migrate:prod": "prisma migrate deploy",
      "prisma:seed": "npx tsx prisma/seed.ts",
      "prisma:studio": "prisma studio"
   },
   "dependencies": {
      "@fastify/compress": "^8.3.1",
      "@fastify/cors": "^11.2.0",
      "@fastify/helmet": "^13.0.2",
      "@fastify/reply-from": "^12.6.2",
      "@fastify/swagger": "^9.7.0",
      "@fastify/swagger-ui": "^5.2.6",
      "@hookform/resolvers": "^3.10.0",
      "@nestjs/cache-manager": "^3.1.2",
      "@nestjs/common": "^11.1.24",
      "@nestjs/config": "^4.0.4",
      "@nestjs/core": "^11.1.24",
      "@nestjs/jwt": "^11.0.2",
      "@nestjs/passport": "^11.0.5",
      "@nestjs/platform-fastify": "^11.1.24",
      "@nestjs/serve-static": "^5.0.5",
      "@nestjs/swagger": "^11.4.4",
      "@nestjs/terminus": "^11.1.1",
      "@nestjs/throttler": "^6.5.0",
      "@prisma/adapter-pg": "^7.8.0",
      "@prisma/client": "^7.8.0",
      "@radix-ui/react-dialog": "^1.1.4",
      "@react-oauth/google": "^0.12.1",
      "@tanstack/react-query": "^5.80.5",
      "axios": "^1.9.0",
      "bcrypt": "^6.0.0",
      "cache-manager": "^7.2.8",
      "class-transformer": "^0.5.1",
      "class-validator": "^0.15.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "dotenv": "^17.4.2",
      "fastify": "^5.8.5",
      "jose": "^5.10.0",
      "js-cookie": "^3.0.5",
      "lucide-react": "^0.511.0",
      "nodemailer": "^8.0.10",
      "passport": "^0.7.0",
      "passport-jwt": "^4.0.1",
      "passport-local": "^1.0.0",
      "pg": "^8.21.0",
      "radix-ui": "^1.4.2",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "react-hook-form": "^7.56.4",
      "react-router-dom": "^7.6.1",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "sonner": "^2.0.3",
      "tailwind-merge": "^3.3.0",
      "tw-animate-css": "^1.4.0",
      "yup": "^1.6.1",
      "zustand": "^5.0.5"
   },
   "devDependencies": {
      "@eslint/eslintrc": "^3.3.5",
      "@eslint/js": "^9.39.4",
      "@nestjs/cli": "^11.0.21",
      "@nestjs/schematics": "^11.1.0",
      "@nestjs/testing": "^11.1.24",
      "@tailwindcss/vite": "^4.1.8",
      "@types/bcrypt": "^6.0.0",
      "@types/jest": "^30.0.0",
      "@types/js-cookie": "^3.0.6",
      "@types/node": "^24.13.0",
      "@types/nodemailer": "^8.0.0",
      "@types/passport-jwt": "^4.0.1",
      "@types/passport-local": "^1.0.38",
      "@types/pg": "^8.20.0",
      "@types/react": "^19.1.5",
      "@types/react-dom": "^19.1.5",
      "@types/supertest": "^7.2.0",
      "@vitejs/plugin-react": "^4.5.2",
      "concurrently": "^10.0.3",
      "cross-env": "^10.1.0",
      "eslint": "^9.39.4",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.6",
      "globals": "^17.6.0",
      "jest": "^30.4.2",
      "prettier": "^3.8.3",
      "prisma": "^7.8.0",
      "source-map-support": "^0.5.21",
      "supertest": "^7.2.2",
      "tailwindcss": "^4.1.8",
      "ts-jest": "^29.4.11",
      "ts-loader": "^9.6.0",
      "ts-node": "^10.9.2",
      "tsconfig-paths": "^4.2.0",
      "tsx": "^4.22.4",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.60.1",
      "vite": "^6.3.5"
   },
   "jest": {
      "moduleFileExtensions": [
         "js",
         "json",
         "ts"
      ],
      "rootDir": "src",
      "testRegex": ".*\\.spec\\.ts$",
      "extensionsToTreatAsEsm": [
         ".ts"
      ],
      "transform": {
         "^.+\\.(t|j)s$": [
            "ts-jest",
            {
               "useESM": true
            }
         ]
      },
      "collectCoverageFrom": [
         "**/*.(t|j)s"
      ],
      "coverageDirectory": "../coverage",
      "testEnvironment": "node"
   }
}
