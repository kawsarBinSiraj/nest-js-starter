# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_PORT=5173
API_PREFIX=api/v1
BODY_LIMIT=10485760
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@example.com

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL=60
CACHE_MAX=100

# ─── Client (SPA) ─────────────────────────────────────────────────────────────
CLIENT_DIST_PATH=dist/public

# ─── Swagger ──────────────────────────────────────────────────────────────────
SWAGGER_TITLE=NestJS Starter API
SWAGGER_DESCRIPTION=Production-ready NestJS API
SWAGGER_VERSION=1.0
